# No credentials are required for Day 1.
# Compose sets SERVICE_ROLE and DOWNSTREAM_URL per service.
# Future provider credentials belong only in an ignored local .env file.
# Optional Day 6 diagnosis; disabled means no model calls. Set secrets outside version control.
SAFEHEAL_LLM_PROVIDER=disabled
SAFEHEAL_LLM_BASE_URL=https://api.openai.com/v1
SAFEHEAL_LLM_MODEL=
SAFEHEAL_LLM_MAX_CALLS=1
SAFEHEAL_LLM_MAX_OUTPUT_TOKENS=800
SAFEHEAL_LLM_TIMEOUT_SECONDS=20
